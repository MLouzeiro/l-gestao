# Copiar para .env e preencher: cp .env.example .env
# NUNCA versionar o .env

# Banco de dados local (Docker) — ver docker-compose.yml
# Porta 5436: 5432/5435 já ocupadas por Postgres de outros projetos nesta máquina
#
# DATABASE_URL = papel da APLICACAO (estoque_app, sem superuser) — é ele que o
#   RLS enxerga; se a app conectasse como superuser, RLS seria ignorado.
# DATABASE_URL_ADMIN = papel dono/DDL (estoque) — só o drizzle migrate usa.
DATABASE_URL=postgresql://estoque_app:estoque@localhost:5436/estoque
DATABASE_URL_ADMIN=postgresql://estoque:estoque@localhost:5436/estoque

# Banco de teste isolado (testes de integração/RLS)
DATABASE_URL_TEST=postgresql://estoque_app:estoque@localhost:5436/estoque_test

# Better Auth
# Gerar um segredo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-aleatorio-longo
# Em dev deixe desligado (a porta do next pode variar; a origem e derivada
# da requisicao). Ligue so em producao:
# BETTER_AUTH_URL=https://seu-dominio.com

# Produção (Neon): definir apenas no painel da Vercel
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
